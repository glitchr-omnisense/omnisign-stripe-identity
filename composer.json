{
    "name": "omnisign/stripe-identity",
    "type": "library",
    "description": "Omnisign Stripe Identity: identity verification through Stripe's VerificationSessions - an identity document photographed live and a selfie matched against it, in Stripe's hosted flow or in the page; the session followed, its report read as the checks performed, cancelled, redacted; webhooks with their Stripe-Signature checked. Test mode with a test key.",
    "keywords": [
        "identity",
        "identity-verification",
        "kyc",
        "eidas",
        "stripe",
        "stripe-identity",
        "omnisign"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnisign-stripe-identity",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnisign": "^1.1@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnisign\\StripeIdentity\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnisign\\StripeIdentity\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        }
    },
    "config": {
        "sort-packages": true
    }
}
